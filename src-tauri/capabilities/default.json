{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Allow the main LLMBench window to use Tauri core APIs, including event listeners for live benchmark metrics.",
  "windows": ["main"],
  "remote": {
    "urls": [
      "http://127.0.0.1:5173",
      "http://127.0.0.1:5173/*",
      "http://localhost:5173",
      "http://localhost:5173/*"
    ]
  },
  "permissions": [
    "core:default",
    "core:event:allow-listen",
    "core:window:allow-close",
    "core:window:allow-minimize",
    "core:window:allow-start-dragging",
    "core:window:allow-toggle-maximize"
  ]
}
