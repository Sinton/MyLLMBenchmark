{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LLMBench",
  "version": "0.1.0",
  "identifier": "com.sinton.llmbench",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LLMBench",
        "width": 1440,
        "height": 920,
        "minWidth": 1280,
        "minHeight": 760,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}
